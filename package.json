{
  "name": "besafe",
  "version": "1.0.0",
  "description": "BeSafe - emergency contact management web application",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "make-admin": "node --env-file-if-exists=.env scripts/make-admin.js",
    "cert": "node scripts/make-cert.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "build": "node scripts/build.js",
    "key": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "express": "^5.3.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1"
  }
}
