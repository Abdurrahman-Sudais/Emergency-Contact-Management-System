{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "vercel-out",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**",
      "maxDuration": 15
    }
  },
  "regions": [
    "lhr1"
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
