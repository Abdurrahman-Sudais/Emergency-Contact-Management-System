{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "node -e \"require('fs').mkdirSync('vercel-out',{recursive:true});require('fs').writeFileSync('vercel-out/robots.txt','User-agent: *\nAllow: /\n')\"",
  "outputDirectory": "vercel-out",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**",
      "maxDuration": 15
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
